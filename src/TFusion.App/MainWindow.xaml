<Window x:Class="TFusion.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TFUSION-720"
        Icon="Assets/TFUSION-720.ico"
        Width="620"
        Height="260"
        MinWidth="520"
        MinHeight="220"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="40">
    <StackPanel VerticalAlignment="Center">
      <TextBlock FontSize="30" FontWeight="SemiBold" Text="TFUSION-720" />
      <TextBlock Margin="0,8,0,0" FontSize="14" Text="{Binding VersionText}" />
      <Border Margin="0,24,0,0" Padding="14" Background="#FFF2F4F7" CornerRadius="4">
        <TextBlock FontSize="15"
                   Text="Engineering foundation — CAD tools not implemented yet"
                   TextWrapping="Wrap" />
      </Border>
    </StackPanel>
  </Grid>
</Window>
