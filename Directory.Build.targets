<Project>
  <Target Name="TFusionRepositoryPolicy" BeforeTargets="PrepareForBuild">
    <Error
      Condition="'$(AllowUnsafeBlocks)' == 'true'"
      Text="Unsafe managed code is prohibited by the approved interop architecture." />
  </Target>

  <Target Name="TFusionRejectPrereleasePackages" BeforeTargets="CollectPackageReferences">
    <ItemGroup>
      <_TFusionPrereleasePackage
        Include="@(PackageVersion)"
        Condition="$([System.String]::Copy('%(PackageVersion.Version)').Contains('-'))" />
    </ItemGroup>
    <Error
      Condition="'@(_TFusionPrereleasePackage)' != ''"
      Text="Prerelease package versions are prohibited: @(_TFusionPrereleasePackage)" />
  </Target>

  <Target
    Name="TFusionCopyNativeRuntime"
    AfterTargets="Build"
    Condition="$([System.String]::Copy('$(TargetFramework)').Contains('-windows')) and Exists('$(MSBuildThisFileDirectory)artifacts/native/package')">
    <ItemGroup>
      <_TFusionNativeRuntime Include="$(MSBuildThisFileDirectory)artifacts/native/package/**/*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(_TFusionNativeRuntime)"
      DestinationFiles="@(_TFusionNativeRuntime->'$(OutDir)%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>

  <Target
    Name="TFusionIncludeNativeRuntimeInPublish"
    BeforeTargets="ComputeFilesToPublish"
    Condition="($([System.String]::Copy('$(TargetFramework)').Contains('-windows'))) and ('$(OutputType)' == 'Exe' or '$(OutputType)' == 'WinExe') and Exists('$(MSBuildThisFileDirectory)artifacts/native/package')">
    <!-- Publish native runtime files only from the executable being published.
         Project-reference libraries also execute ComputeFilesToPublish; adding the same
         package from each referenced project produces NETSDK1152 duplicate output paths. -->
    <ItemGroup>
      <ResolvedFileToPublish Include="$(MSBuildThisFileDirectory)artifacts/native/package/**/*">
        <RelativePath>%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
