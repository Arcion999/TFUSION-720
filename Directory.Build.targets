<Project>
  <Target Name="TFusionRepositoryPolicy" BeforeTargets="PrepareForBuild">
    <Error
      Condition="'$(AllowUnsafeBlocks)' == 'true'"
      Text="Unsafe managed code is prohibited by the approved interop architecture." />
  </Target>

  <Target Name="TFusionRejectPrereleasePackages" BeforeTargets="CollectPackageReferences">
    <ItemGroup>
      <_TFusionPrereleasePackage
        Include="@(PackageVersion)"
        Condition="$([System.String]::Copy('%(PackageVersion.Version)').Contains('-'))" />
    </ItemGroup>
    <Error
      Condition="'@(_TFusionPrereleasePackage)' != ''"
      Text="Prerelease package versions are prohibited: @(_TFusionPrereleasePackage)" />
  </Target>

  <Target
    Name="TFusionCopyNativeRuntime"
    AfterTargets="Build"
    Condition="$([System.String]::Copy('$(TargetFramework)').Contains('-windows')) and Exists('$(MSBuildThisFileDirectory)artifacts/native/package')">
    <ItemGroup>
      <_TFusionNativeRuntime Include="$(MSBuildThisFileDirectory)artifacts/native/package/**/*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(_TFusionNativeRuntime)"
      DestinationFiles="@(_TFusionNativeRuntime->'$(OutDir)%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>
</Project>
